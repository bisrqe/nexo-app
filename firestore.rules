rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de cada cuenta — cualquiera con sesión puede verlo (para el
    // directorio de Personas y "quién se interesó en tu iniciativa"),
    // pero solo su dueño puede escribirlo.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Iniciativas — dossier público (lo ve cualquier visitante, con o sin
    // cuenta). Solo el dueño puede crear/editar/borrar, salvo el campo
    // interestedBy: cualquier cuenta puede agregar o quitar únicamente su
    // propio uid ahí (el botón "Me interesa"). .get(field, default) evita
    // truene si la iniciativa todavía no tiene ese campo.
    match /initiatives/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedBy']) &&
          (request.auth.uid in request.resource.data.get('interestedBy', [])) !=
          (request.auth.uid in resource.data.get('interestedBy', []))
        )
      );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Eventos — dossier público, igual que iniciativas (la landing de
    // /eventos la ve gente sin cuenta). Editables solo por su dueño.
    match /events/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Mesas de trabajo — cualquier cuenta con sesión las puede ver y
    // unirse (el "unirse" en sí vive en profiles/{uid}.joinedGroups, no
    // aquí); solo el dueño edita/borra la mesa. El chat de cada mesa
    // (subcolección messages) solo lo puede leer/escribir quien tenga
    // ese groupId en su propio perfil — mismo nivel de privacidad que
    // el chat directo, nadie fuera del grupo ve los mensajes.
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      // El dueño puede editar cualquier campo (nombre, descripción, etc.);
      // cualquier otro miembro solo puede tocar los campos de "último
      // mensaje" que actualiza el chat al mandar un mensaje.
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        (
          groupId in get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('joinedGroups', []) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastSenderUid', 'updatedAt', 'messageCount'])
        )
      );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /messages/{msgId} {
        allow read: if request.auth != null &&
          groupId in get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('joinedGroups', []);
        allow create: if request.auth != null &&
          groupId in get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('joinedGroups', []) &&
          request.resource.data.senderUid == request.auth.uid;
      }
    }

    // Chat directo entre dos cuentas. El id del documento es "uidA_uidB"
    // (ordenado), así que solo puede existir una conversación por par de
    // personas. Nadie fuera de esas dos puede leerla ni escribirla; una
    // vez creada, no se puede cambiar quiénes son sus participantes, solo
    // los campos de "último mensaje" que muestra la lista de chats.
    match /conversations/{convId} {
      // resource == null cuando el doc todavía no existe (se está
      // comprobando si ya hay conversación con esa persona antes de
      // crearla) — sin ese caso, leer un id que no existe truena en vez
      // de regresar "no existe". La cuenta admin (mismo correo que
      // ADMIN_EMAILS en src/data/admins.js) puede leer todas para el
      // panel de KPIs — nunca puede leer los mensajes en sí (ver abajo).
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid in resource.data.participants ||
         request.auth.token.email == 'bismarck@bisrqe.com');
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessage', 'lastSenderUid', 'messageCount']);

      match /messages/{msgId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants &&
          request.resource.data.senderUid == request.auth.uid;
      }
    }
  }
}
