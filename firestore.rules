rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cuentas del equipo de Nexo — mismos correos que src/data/admins.js
    // (isStaffUser). La cuenta de soporte solo cuenta con el correo
    // VERIFICADO: sin eso, cualquiera podría registrarse con esa dirección
    // antes que el equipo y heredar permisos de admin.
    function isStaff() {
      return request.auth != null && (
        request.auth.token.email == 'bismarck@bisrqe.com' ||
        (request.auth.token.email == 'support@nexohub.mx' && request.auth.token.email_verified == true)
      );
    }

    // Perfil de cada cuenta — cualquiera con sesión puede verlo (para el
    // directorio de Personas y "quién se interesó en tu iniciativa"),
    // pero solo su dueño puede escribirlo.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Iniciativas — dossier público (lo ve cualquier visitante, con o sin
    // cuenta). El dueño puede editar/borrar cualquier cosa, incluyendo a
    // quién más está ligado (memberUids) — así es como se agrega a un
    // cofundador con cuenta distinta al mismo emprendimiento. Cualquier
    // otro miembro ya ligado puede editar el contenido, pero no puede
    // tocar ownerUid ni memberUids (eso solo lo mueve el dueño). Aparte,
    // cualquier cuenta puede agregar o quitar únicamente su propio uid en
    // interestedBy (el botón "Me interesa"). .get(field, default) evita
    // que truene si la iniciativa todavía no tiene ese campo.
    match /initiatives/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        (
          request.auth.uid in resource.data.get('memberUids', []) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.get('memberUids', []) == resource.data.get('memberUids', [])
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedBy']) &&
          (request.auth.uid in request.resource.data.get('interestedBy', [])) !=
          (request.auth.uid in resource.data.get('interestedBy', []))
        )
      );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Eventos — dossier público, igual que iniciativas (la landing de
    // /eventos la ve gente sin cuenta). Solo el dueño edita/borra, salvo
    // el campo attendees: cualquier cuenta puede agregar o quitar
    // únicamente su propio uid ahí (el botón "Inscribirme").
    match /events/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees']) &&
          (request.auth.uid in request.resource.data.get('attendees', [])) !=
          (request.auth.uid in resource.data.get('attendees', []))
        )
      );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Recursos capturados a mano (convocatorias, financiamiento, etc.) —
    // se suman a los que ya vienen fijos en src/data/resources.js. Lectura
    // pública igual que iniciativas/eventos (el cliente filtra los que
    // están "pending" para que solo los vea quien aprueba). La cuenta
    // admin/aprobadora (mismo correo que ADMIN_EMAILS/RESOURCE_APPROVER_EMAILS
    // en src/data/admins.js — hoy es la misma) los agrega ya aprobados,
    // los edita, aprueba o borra sin restricción. Cualquier otra cuenta con
    // sesión puede sugerir uno nuevo, pero siempre queda "pending" y a su
    // propio nombre — no puede autoaprobarse ni tocar los de alguien más.
    match /resources/{id} {
      allow read: if true;
      allow create: if request.auth != null && (
        isStaff() ||
        (
          request.resource.data.status == 'pending' &&
          request.resource.data.submittedByUid == request.auth.uid
        )
      );
      allow update, delete: if isStaff();
    }

    // Mesas de trabajo — cualquier cuenta con sesión las puede ver y
    // unirse (el "unirse" en sí vive en profiles/{uid}.joinedGroups, no
    // aquí). adminUids son las cuentas con permiso de administrar la mesa
    // (el dueño empieza ahí, y puede agregar colaboradores con los mismos
    // permisos) — cualquiera en adminUids puede editar cualquier campo,
    // borrar la mesa, y agregar/quitar admins, salvo que a ownerUid no se
    // le puede quitar de adminUids (eso protege que la mesa se quede sin
    // dueño). Cualquier otro miembro (no admin) solo puede tocar los
    // campos de "último mensaje" que actualiza el chat al mandar un
    // mensaje. El chat de cada mesa (subcolección messages) solo lo puede
    // leer/escribir quien tenga ese groupId en su propio perfil — mismo
    // nivel de privacidad que el chat directo, nadie fuera del grupo ve
    // los mensajes.
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.adminUids == [request.auth.uid];
      allow update: if request.auth != null && (
        (
          request.auth.uid in resource.data.get('adminUids', [resource.data.ownerUid]) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          resource.data.ownerUid in request.resource.data.get('adminUids', [])
        ) ||
        (
          groupId in get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('joinedGroups', []) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastSenderUid', 'updatedAt', 'messageCount'])
        )
      );
      allow delete: if request.auth != null &&
        request.auth.uid in resource.data.get('adminUids', [resource.data.ownerUid]);

      match /messages/{msgId} {
        allow read: if request.auth != null &&
          groupId in get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('joinedGroups', []);
        allow create: if request.auth != null &&
          groupId in get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('joinedGroups', []) &&
          request.resource.data.senderUid == request.auth.uid;
      }
    }

    // Chat directo entre dos cuentas. El id del documento es "uidA_uidB"
    // (ordenado), así que solo puede existir una conversación por par de
    // personas. Nadie fuera de esas dos puede leerla ni escribirla; una
    // vez creada, no se puede cambiar quiénes son sus participantes, solo
    // los campos de "último mensaje" que muestra la lista de chats.
    match /conversations/{convId} {
      // resource == null cuando el doc todavía no existe (se está
      // comprobando si ya hay conversación con esa persona antes de
      // crearla) — sin ese caso, leer un id que no existe truena en vez
      // de regresar "no existe". La cuenta admin (mismo correo que
      // ADMIN_EMAILS en src/data/admins.js) puede leer todas para el
      // panel de KPIs — nunca puede leer los mensajes en sí (ver abajo).
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid in resource.data.participants || isStaff());
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessage', 'lastSenderUid', 'messageCount']);

      match /messages/{msgId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants &&
          request.resource.data.senderUid == request.auth.uid;
      }
    }

    // Retroalimentación mandada desde el chatbot (landing o dashboard) —
    // cualquiera puede mandar una, con o sin cuenta; nadie la puede leer
    // de vuelta desde el cliente, solo se revisa desde la consola de
    // Firebase. Valida forma y tamaño para frenar spam obvio.
    match /feedback/{id} {
      allow create: if request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 2000;
      allow read, update, delete: if false;
    }

    // Denuncias de eventos ("Denunciar evento" en el detalle) — solo
    // cuentas con sesión, y solo a nombre de sí mismas (reporterUid).
    // Mismo patrón que "feedback": nadie las puede leer de vuelta desde
    // el cliente, solo se revisan desde la consola de Firebase.
    match /eventReports/{id} {
      allow create: if request.auth != null &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.eventId is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.get('details', '').size() <= 2000;
      allow read, update, delete: if false;
    }

    // Disparador de los correos de verificación/restablecimiento con
    // plantilla propia (ver onAuthEmailRequested en functions/index.js) —
    // nadie los lee de vuelta, solo los procesa la función con permisos de
    // administrador. "verify" requiere sesión y solo a nombre de uno
    // mismo; "reset" es público (como el flujo normal de "olvidé mi
    // contraseña"), validado solo por forma para frenar spam obvio.
    match /authEmailRequests/{id} {
      allow create: if (
        request.resource.data.type == 'verify' &&
        request.auth != null &&
        request.resource.data.uid == request.auth.uid
      ) || (
        request.resource.data.type == 'reset' &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.email.size() <= 320
      );
      allow read, update, delete: if false;
    }
  }
}
