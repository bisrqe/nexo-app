rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de cada cuenta — cualquiera con sesión puede verlo (para el
    // directorio de Personas y "quién se interesó en tu iniciativa"),
    // pero solo su dueño puede escribirlo.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Iniciativas — dossier público (lo ve cualquier visitante, con o sin
    // cuenta). Solo el dueño puede crear/editar/borrar, salvo el campo
    // interestedBy: cualquier cuenta puede agregar o quitar únicamente su
    // propio uid ahí (el botón "Me interesa"). .get(field, default) evita
    // truene si la iniciativa todavía no tiene ese campo.
    match /initiatives/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedBy']) &&
          (request.auth.uid in request.resource.data.get('interestedBy', [])) !=
          (request.auth.uid in resource.data.get('interestedBy', []))
        )
      );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Eventos creados por cuentas del dashboard — visibles solo dentro
    // del dashboard (con sesión), editables solo por su dueño.
    match /events/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
